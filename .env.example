# Use the Supabase Session Pooler connection string (never put it in browser files).
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres

# Make a long random secret (at least 32 characters). Keep it private.
COOKIE_SECRET=replace-with-a-long-random-secret-value

# Use a strong organiser password. These values are set in the hosting dashboard.
ADMIN_USERNAME=organiser
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional branding
SCHOOL_NAME=YOUR SCHOOL NAME
EXHIBITION_NAME=MATHEMATICS EXHIBITION
NODE_ENV=development
